{
  "name": "sgs-sim",
  "productName": "Three Kingdoms Evolution",
  "version": "1.11.3",
  "description": "進化三國模擬器 (桌面版)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.sgs.sim",
    "productName": "Three Kingdoms Evolution",
    "files": [
      "main.js",
      "preload.js",
      "preload-main.js",
      "connect.html",
      "package.json",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist/sgs-server",
        "to": "server"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "${productName} ${version}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "icon": "icon.png"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.0"
  }
}
